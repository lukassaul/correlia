correlia.org {
    encode gzip

    @api path /health /health/* /indicators /indicators/* /correlate /correlate/* /scan /scan/*
    handle @api {
        reverse_proxy api:8000
    }

    handle {
        root * /srv/frontend
        file_server
    }
}

www.correlia.org {
    redir https://correlia.org{uri} permanent
}
EOF
